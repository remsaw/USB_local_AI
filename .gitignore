# ========================================================
# Git Ignore for USB Local AI
# Never commit multi-gigabyte models or executable binaries
# ========================================================

# Model weights
*.gguf
*.bin
*.safetensors
Models/*
!Models/README.md
!Models/.gitkeep

# Executable binaries & downloaded distributions
llama-router/
llamafile*
*.exe
*.dll
*.zip

# Generated runtime configuration & logs
models.ini
*.log
*.tmp

# Portable chat history & uploaded media (privacy)
Data/conversations.json
Data/*.tmp
Data/uploads/*
!Data/uploads/.gitkeep
!Data/README.txt

# Windows system & USB drive files
System Volume Information/
$RECYCLE.BIN/
[Dd]esktop.ini
Thumbs.db
.DS_Store
